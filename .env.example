# Backend Configuration
BACKEND_PORT=3001
BACKEND_ENV=development
NODE_ENV=development

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=smartcampus
DB_PASSWORD=secure_password_change_me
DB_NAME=smartcampus_omnidesk
DB_SYNCHRONIZE=false
DB_LOGGING=true

# JWT
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRATION=7d

# OAuth2 Google
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Frontend
FRONTEND_URL=http://localhost:3000
FRONTEND_PORT=3000

# WhatsApp API Integration
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_access_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=your_webhook_verify_token

# Banner Ellucian Integration
BANNER_API_URL=https://banner-api.ucin.edu.pe
BANNER_API_KEY=your_banner_api_key
BANNER_USERNAME=banner_integration_user
BANNER_PASSWORD=banner_integration_password

# Notifications
NOTIFICATION_RETENTION_DAYS=30
SLA_HIGH_PRIORITY_HOURS=8
SLA_NORMAL_PRIORITY_HOURS=24

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Email Configuration (if needed)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@ucin.edu.pe
